config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/10300000.wmac'
	option band '2g'
	option htmode 'HT20'
	option country 'IN'
	option channel '6'
	option disabled '0'
	option txpower '21'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'HomeMesh-WiFi'
	option encryption 'psk2'
	option key 'ChangeThisToYourSecurePassword123'
	option ieee80211r '1'
	option mobility_domain '1395'
	option ft_over_ds '0'
	option ft_psk_generate_local '1'
	option ieee80211k '1'
	option isolate '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'pci0000:00/0000:00:00.0/0000:01:00.0'
	option band '5g'
	option htmode 'VHT80'
	option country 'IN'
	option channel '149'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
