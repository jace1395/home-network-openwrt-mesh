config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fdae:6c08:a13f::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0.1'
	option stp '0'
	option forward_delay '0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option netmask '255.255.255.0'
	option ip6assign '60'
	option ipaddr '192.168.1.3'
	option gateway '192.168.1.1'
	list dns '127.0.0.1'

config device
	option name 'eth0.2'
	option macaddr 'aa:bb:cc:00:00:04'

config switch
	option name 'switch0'
	option reset '1'
	option enable_vlan '1'

# All 5 ports bridged into VLAN 1 (1 WAN + 4 LAN converted to 5-port LAN switch)
config switch_vlan
	option device 'switch0'
	option vlan '1'
	option ports '0 1 2 3 4 6t'
