config system
	option ttylogin '0'
	option log_size '64'
	option urandom_seed '0'
	option hostname 'OpenWrt-ArcherC20'
	option timezone 'IST-5:30'
	option zonename 'Asia/Kolkata'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'

config led 'led_lan'
	option name 'LAN'
	option sysfs 'green:lan'
	option trigger 'switch0'
	option port_mask '0x1f'

config led 'led_wan'
	option name 'WAN'
	option sysfs 'green:wan'
	option trigger 'switch0'
	option port_mask '0x01'

config led 'led_wlan2g'
	option name 'WLAN2G'
	option sysfs 'green:wlan2g'
	option trigger 'phy0tpt'

config led 'led_wlan5g'
	option name 'WLAN5G'
	option sysfs 'green:wlan5g'
	option trigger 'phy1tpt'

config led 'led_power'
	option name 'POWER'
	option sysfs 'green:power'
	option trigger 'default-on'
